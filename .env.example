# Sanity — Salty Cape (project y83nf1qy, dataset production)
# Copy to .env.local and fill in. The three NEXT_PUBLIC_ vars are safe to expose.

NEXT_PUBLIC_SANITY_PROJECT_ID=y83nf1qy
NEXT_PUBLIC_SANITY_DATASET=production
# Pin the API version to a date — never "v1"/"vX", whose behavior can drift.
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# Absolute site origin for sitemap.xml, robots.txt and JSON-LD URLs.
# No trailing slash. Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=https://saltycape.com

# Cloudflare Worker serving tide/current/conditions data (client-side fetched).
# NOTE: the Worker CORS-whitelists a single origin (salty-cape.webflow.io); until
# our origins are added there, browser fetches fail and the UI shows its error state.
NEXT_PUBLIC_WORKER_URL=https://salty-cape-api.hogylureco.workers.dev

# Read token with access to draft documents.
# Required in development only: the imported Salty Cape content lives in DRAFTS,
# and draft reads are not anonymous. Create one at
# https://www.sanity.io/manage → project y83nf1qy → API → Tokens (Viewer role).
# Server-only — do NOT prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
