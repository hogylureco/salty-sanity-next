# Sanity — Salty Cape (project y83nf1qy, dataset production)
# Copy to .env.local and fill in. The three NEXT_PUBLIC_ vars are safe to expose.

NEXT_PUBLIC_SANITY_PROJECT_ID=y83nf1qy
NEXT_PUBLIC_SANITY_DATASET=production
# Pin the API version to a date — never "v1"/"vX", whose behavior can drift.
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# Absolute site origin for sitemap.xml, robots.txt and JSON-LD URLs.
# No trailing slash. Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=https://saltycape.com

# Shared secret validating Sanity revalidation webhooks (POST /api/revalidate).
# Generate with `openssl rand -base64 32`. Set the SAME value in Sanity Manage's
# webhook "Secret" field and in the Vercel env vars. Server-only — never commit.
SANITY_REVALIDATE_SECRET=

# Builder.io public API key (marketing composition layer). Paste from the
# Builder space → Account Settings. Public (client-exposed) by design.
NEXT_PUBLIC_BUILDER_API_KEY=

# Cloudflare Worker base URL. Serves tide/current/conditions JSON (client-side
# fetched) AND the Spot map's XYZ tile routes: /noaa-chart/paper, /noaa-chart/ecdis,
# and /openseamap (the Worker does the NOAA WMS→XYZ translation server-side, so the
# client uses plain L.tileLayer). Tiles load as <img>, so they're unaffected by the
# Worker's JSON CORS whitelist (a single origin, salty-cape.webflow.io) — but until
# our origins are added there, the JSON fetches fail and those modules show an error.
NEXT_PUBLIC_WORKER_URL=https://salty-cape-api.hogylureco.workers.dev

# Write token (Editor+), used ONLY by scripts/publish-all.ts to publish drafts.
# Not needed at runtime. Server-only — never commit the real value.
SANITY_API_WRITE_TOKEN=

# Read token with access to draft documents.
# Required in development only: the imported Salty Cape content lives in DRAFTS,
# and draft reads are not anonymous. Create one at
# https://www.sanity.io/manage → project y83nf1qy → API → Tokens (Viewer role).
# Server-only — do NOT prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# XWeather (Aeris) credentials for the Sea Surface Temperature readout on the
# spot Weather tab. Used ONLY server-side by /api/sst (lib/weather-xweather.ts)
# via the maritime data API — the browser never sees them. Server-only — do NOT
# prefix with NEXT_PUBLIC_. The client_secret is a secret; treat it like a
# password. (A third XWeather "API key"/maps token is not needed for SST.)
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
